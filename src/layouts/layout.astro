---
import { pwaInfo } from 'virtual:pwa-info'; // eslint-disable-line

import { AuroraBackground } from '@/components/aurora-background';
import { Reload } from '@/components/reload';

import { count } from '@/lib/sounds';

import '@/styles/global.css';

interface Props {
  description?: string;
  title?: string;
}

const title = Astro.props.title || 'FeelbetterLab';
const description =
  Astro.props.description ||
  `FeelbetterLab offre ${count()} tracce audio curate per supportare benessere, rilassamento e concentrazione, con un approccio professionale e orientato alla salute.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <meta content={Astro.generator} name="generator" />
    <meta content="#061928" name="theme-color" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />

    <title>{title}</title>
    <meta content={title} name="title" />
    <meta content={description} name="description" />

    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="FeelbetterLab" property="og:site_name" />
    <meta content="https://moodist.app" property="og:url" />
    <meta content="website" property="og:type" />
    <meta content="https://moodist.app/og.png" property="og:image" />

    <meta content="summary_large_image" name="twitter:card" />

    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
  </head>
  <body>
    <AuroraBackground client:only="react" />
    <div class="pageRoot">
      <slot />
    </div>

    <Reload client:load />
  </body>
</html>
